<group name="modsecurity,web,appsec,owasp">
  
  <!-- Base ModSecurity Event Detection (JSON) -->
  <rule id="100002" level="5">
    <decoded_as>json</decoded_as>
    <field name="transaction.messages">\.+</field>
    <description>ModSecurity: Web Application Attack Attempt</description>
    <group>web,appsec,attack</group>
  </rule>

  <!-- SQL Injection Attacks (OWASP CRS 942xxx) -->
  <rule id="100010" level="12">
    <if_sid>100002</if_sid>
    <match>SQL Injection</match>
    <description>OWASP_CRS: SQL Injection Attack Detected</description>
    <group>web,appsec,attack,sqli,owasp_crs,pci_dss_6.5.1,pci_dss_11.4</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100011" level="12">
    <if_sid>100002</if_sid>
    <id>^942100$</id>
    <description>OWASP_CRS: SQL Injection Attack - Union/Select/Boolean/Time-based</description>
    <group>web,appsec,attack,sqli,owasp_crs</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100012" level="12">
    <if_sid>100002</if_sid>
    <id>^942110$</id>
    <description>OWASP_CRS: SQL Injection - Tautology Attack (1=1, 'a'='a')</description>
    <group>web,appsec,attack,sqli,owasp_crs</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <!-- XSS Attacks (OWASP CRS 941xxx) -->
  <rule id="100020" level="12">
    <if_sid>100002</if_sid>
    <match>XSS</match>
    <description>OWASP_CRS: Cross-Site Scripting (XSS) Attack Detected</description>
    <group>web,appsec,attack,xss,owasp_crs,pci_dss_6.5.7,pci_dss_11.4</group>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100021" level="12">
    <if_sid>100002</if_sid>
    <id>^941100$</id>
    <description>OWASP_CRS: XSS Attack - Script/Event Handler/JavaScript Protocol</description>
    <group>web,appsec,attack,xss,owasp_crs</group>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100022" level="12">
    <if_sid>100002</if_sid>
    <id>^941110$</id>
    <description>OWASP_CRS: XSS Attack - HTML Injection (iframe/embed/object)</description>
    <group>web,appsec,attack,xss,owasp_crs</group>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- Path Traversal Attacks (OWASP CRS 930xxx) -->
  <rule id="100030" level="12">
    <if_sid>100002</if_sid>
    <match>Path Traversal</match>
    <description>OWASP_CRS: Path Traversal Attack Detected</description>
    <group>web,appsec,attack,path-traversal,owasp_crs,pci_dss_6.5.8,pci_dss_11.4</group>
    <mitre>
      <id>T1083</id>
    </mitre>
  </rule>

  <rule id="100031" level="12">
    <if_sid>100002</if_sid>
    <id>^930100$</id>
    <description>OWASP_CRS: Path Traversal - Directory Traversal (../, /etc/passwd)</description>
    <group>web,appsec,attack,path-traversal,owasp_crs</group>
    <mitre>
      <id>T1083</id>
    </mitre>
  </rule>

  <rule id="100032" level="13">
    <if_sid>100002</if_sid>
    <id>^930110$</id>
    <description>OWASP_CRS: Path Traversal - Null Byte Injection</description>
    <group>web,appsec,attack,path-traversal,owasp_crs</group>
    <mitre>
      <id>T1083</id>
    </mitre>
  </rule>

  <!-- Command Injection Attacks (OWASP CRS 932xxx) -->
  <rule id="100040" level="13">
    <if_sid>100002</if_sid>
    <match>Command Injection|OS Command</match>
    <description>OWASP_CRS: OS Command Injection Attack Detected</description>
    <group>web,appsec,attack,command-injection,owasp_crs,pci_dss_6.5.1,pci_dss_11.4</group>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100041" level="13">
    <if_sid>100002</if_sid>
    <id>^932100$</id>
    <description>OWASP_CRS: OS Command Injection - Shell Commands Detected</description>
    <group>web,appsec,attack,command-injection,owasp_crs</group>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- Shell Injection (Legacy compatibility) -->
  <rule id="100050" level="13">
    <if_sid>100002</if_sid>
    <match>Shell Injection</match>
    <description>ModSecurity: Shell Injection Attempt Blocked</description>
    <group>web,appsec,attack,shell-injection</group>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- Aggregation Rules - Multiple Attacks from Same Source -->
  <rule id="100060" level="14" frequency="5" timeframe="120">
    <if_matched_sid>100010,100020,100030,100040</if_matched_sid>
    <description>OWASP_CRS: Multiple Web Attacks from Same Source (Possible Automated Scanner)</description>
    <group>web,appsec,attack,multiple_attacks,owasp_crs</group>
    <mitre>
      <id>T1595</id>
    </mitre>
  </rule>

  <rule id="100061" level="15" frequency="10" timeframe="60">
    <if_matched_sid>100010</if_matched_sid>
    <description>OWASP_CRS: SQL Injection Attack Burst - Possible Automated Attack</description>
    <group>web,appsec,attack,sqli,burst,owasp_crs</group>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100062" level="15" frequency="10" timeframe="60">
    <if_matched_sid>100020</if_matched_sid>
    <description>OWASP_CRS: XSS Attack Burst - Possible Automated Attack</description>
    <group>web,appsec,attack,xss,burst,owasp_crs</group>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

</group>

